# Production settings for the Oracle server. Copy to .env ON THE SERVER, fill in
# the blanks, then: chmod 600 .env
# Generate every secret on the server, never copy the laptop .env:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Everything not listed here keeps the defaults in .env.example.

APP_ENV=production
ENABLE_DEV_AUTH=false

# A key made for this server only, with a key limit set at
# openrouter.ai/settings/keys (e.g. $5). Never reuse the laptop key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-v4-flash

JWT_SECRET=
JWT_EXPIRE_MINUTES=60
# token_id values of revoked service tokens, comma-separated.
REVOKED_TOKEN_IDS=

# docker-compose.yml builds DATABASE_URL from this and sets REQUIRE_DATABASE.
POSTGRES_PASSWORD=

# Explicit origins only (the app refuses * in production), e.g. your tailnet URL.
CORS_ORIGINS=

# Spend limits. Worst case for one /project/optimize request with these values:
# 2 candidates x 2 attempts x (3 rounds x 5 calls + 4 judge calls) + 1 = 77 calls.
# (3 candidates would be 115 calls, above the cap below.)
MAX_REVISIONS=3
HARNESS_CANDIDATES=2
HARNESS_MAX_REVISIONS=2
HARNESS_MAX_MODEL_CALLS=100
HARNESS_REASONING_EFFORT=none
# Signs the persona library and run history.
HARNESS_HMAC_KEY=
