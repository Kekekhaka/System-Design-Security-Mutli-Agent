# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# development | production. production refuses to start with ENABLE_DEV_AUTH=true,
# CORS_ORIGINS=* or no DATABASE_URL.
APP_ENV=development
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Strongly recommended: another OpenRouter model id used when the primary is
# rate limited or down (startup logs a warning while this is unset).
# OPENROUTER_FALLBACK_MODEL=<another-model-id-on-openrouter>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Verify TLS with the OS certificate store (needed behind TLS-inspecting proxies)
USE_OS_TRUST_STORE=true
# Output budget per call incl. reasoning tokens; 4096 left DeepSeek V4 Flash with no text
LLM_MAX_TOKENS=32000
# Fast mode for live demos: "none" turns hidden reasoning off (several times faster, less thorough).
# Leave empty for the model's default.
LLM_REASONING_EFFORT=
# Hard deadline for any single model call, in seconds (0 disables)
LLM_CALL_TIMEOUT_SECONDS=1200
# Design-to-spec export (scripts/export_design.py): reasoning off, bigger output budget
EXPORT_REASONING_EFFORT=none
EXPORT_MAX_TOKENS=64000
APP_BASE_URL=http://localhost:8000
APP_TITLE=System Design & AppSec Agent
# Required, 32+ random chars; the app refuses to start with this placeholder.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
MAX_REVISIONS=5
# POST /project/design returns 504 after this; use /project/design/stream for full runs
DESIGN_TIMEOUT_SECONDS=120
HARNESS_CANDIDATES=3
# true = POST /auth/token mints a token for ANY username, no password.
# Local testing only; keep false anywhere reachable by others.
ENABLE_DEV_AUTH=false

# AppSec RAG (scope -> analyze -> validate security pipeline)
SECURITY_RAG_ENABLED=true
SECURITY_RAG_TOP_K=3
# KNOWLEDGE_DIR=C:\path\to\knowledge\appsec

# Design-time RAG (architecture reference patterns for the designer)
DESIGN_RAG_ENABLED=true
DESIGN_RAG_TOP_K=3
# DESIGN_KNOWLEDGE_DIR=C:\path\to\knowledge\system-design

# Retrieval backend: bm25 (offline default) or chroma (pip install -r requirements-chroma.txt)
RAG_BACKEND=bm25
# CHROMA_DIR=C:\path\to\.chroma

# Browser CORS origins (comma-separated; * allows all)
CORS_ORIGINS=*

# Durable sessions (leave empty for in-memory checkpointer)
# DATABASE_URL=postgresql://user:pass@localhost:5432/agentcheckpoints
# Set true in production so a missing DATABASE_URL fails startup instead of
# silently falling back to memory.
REQUIRE_DATABASE=false
# docker compose only: password for the bundled Postgres container (required)
POSTGRES_PASSWORD=change-me

# Langfuse tracing (leave empty to disable)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# Harness2 persona library (see README "Harness2 learns")
# HARNESS_STORE_PATH=data/harness/personas.json
# HARNESS_HISTORY_PATH=data/harness/history.jsonl
# HARNESS_MAX_REVISIONS=0
# HARNESS_LIBRARY_CAP=12
# Reasoning is off by default for harness runs.
HARNESS_REASONING_EFFORT=none
# Opt in to the promoted champion in the team's design and code audits.
HARNESS_USE_CHAMPION=false
# HMAC key for store/history integrity (supply from a secret manager, never commit).
# HARNESS_HMAC_KEY=
# Hard per-run model-call budget (0 = estimate + 2).
HARNESS_MAX_MODEL_CALLS=0
HARNESS_SANITY_FIXTURES=2

# Everything runs through OpenRouter. Model clients refuse any other endpoint unless
# you deliberately set ALLOW_NON_OPENROUTER=true.
ALLOW_NON_OPENROUTER=false

# Team build runs (scripts/run_team.py --build): opencode, also via OpenRouter.
OPENCODE_MODEL=openrouter/deepseek/deepseek-v4-flash
# A DEDICATED key with a small credit limit (openrouter.ai/settings/keys). Passed to the
# opencode process only; must differ from OPENROUTER_API_KEY. Builds refuse to start without it.
OPENCODE_OPENROUTER_API_KEY=
